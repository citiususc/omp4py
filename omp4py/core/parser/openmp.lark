##################################################################################
##                                                                              ##
## To generate the OpenMP parser from this grammar use the following command:   ##
##                                                                              ##
##   python -m lark.tools.standalone openmp.lark \                              ##
##     --out openmp_parser.py --propagate_positions --maybe_placeholders        ##
##                                                                              ##
##################################################################################

##################################################################################
#################################### Templates ###################################
##################################################################################
lit{x}      : x -> literal
py_lit{x}   : x -> py_lit
list{x}     : x ("," x)* -> as_list

##################################################################################
################################### Directives ###################################
##################################################################################
start: basic_construct                              clauses  -> basic_directive
     | comp_constructs                              clauses  -> compound_directive
     | lit{"atomic"i}                        atomic_clauses  -> atomic_dir
     | lit{"threadprivate"i}  "(" list{py_name} ")" clauses  -> thprivate_dir
     | lit{"cancel"i}         can_construct         clauses  -> cancel_dir
     | lit_can_point          can_construct         clauses  -> can_point_dir
     | lit_dec_reduction      "(" _HM reduction_op ":" list{py_expr_lite} [dec_rec_mod_old] ")" clauses -> dec_reduction_dir


?basic_construct: lit{"taskyield"i}  |  lit{"critical"i} | lit{"barrier"i} | lit{"taskwait"i} | lit{"flush"i}
                | lit{"taskgroup"i}  | lit{"ordered"i}   | lit{"declare_simd"i}  | lit{"declare_target"i}
                | lit{"target"i}  lit{"data"i}                -> literal
                | lit{"target"i}  lit{"update"i}              -> literal
                | lit{"target"i}  lit{"enter"i} lit{"data"i}  -> literal
                | lit{"target"i}  lit{"exit"i}  lit{"data"i}  -> literal
                | lit{"declare"i} lit{"simd"i}                -> literal
                | lit{"declare"i} lit{"target"i}              -> literal
                | comp_construct

lit_can_point     : lit{"cancellation_point"i}  | lit{"cancellation"i}  lit{"point"i}      -> literal
lit_dec_reduction : lit{"declare_reduction"i}   | lit{"declare"i}       lit{"reduction"i}  -> literal
can_construct     : lit{"parallel"i} | lit{"sections"i} | lit{"for"i} | lit{"taskgroup"i}  -> literal


##################################################################################
################################### Composition ##################################
##################################################################################
!comp_constructs : comp_construct (["_"] comp_construct)+

?comp_construct: lit{"target"i}     | lit{"for"i}     | lit{"task"i}     | lit{"simd"i}     | lit{"parallel"i}
               | lit{"single"i}     | lit{"teams"i}   | lit{"taskloop"i} | lit{"sections"i} | lit{"masked"i}
               | lit{"target_update"i}                | lit{"target_data"i}                 | lit{"distribute"i}
               | lit{"target_enter_data"i}            | lit{"target_exit_data"i}            | lit{"master"i}

##################################################################################
##################################### Clauses ####################################
##################################################################################
clauses : clause* -> as_list

clause : lit{"aligned"i}       "(" [_HM] list{py_name}    [":"  aligned_mods]      ")"
       | lit{"collapse"i}      "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"combiner"i}      "(" [_HM  list{mod_default} ":"] py_code            ")"
       | lit{"copyin"i}        "(" [_HM  list{mod_default} ":"] list{py_name}      ")"
       | lit{"copyprivate"i}   "(" [_HM  list{mod_default} ":"] list{py_name}      ")"
       | lit{"default"i}       "(" [_HM]                        (lit{"firstprivate"i} | lit{"none"i} | lit{"private"i} | lit{"shared"i}) \
                                                          [":"  list{mod_default}] ")"
       | lit{"defaultmap"i}    "(" [_HM]                        lit{"tofrom"i} \  
                                                          [":"  defaultmap_mods]   ")"
       | lit{"depend"i}        "(" [_HM  depend_mods       ":"] list{py_name}      ")"
       | lit{"device"i}        "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"dist_schedule"i} "(" [_HM  list{mod_default} ":"] lit{"static"i} ["," py_expr ] ")"
       | lit{"filter"i}        "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"final"i}         "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"firstprivate"i}  "(" [_HM  list{mod_default} ":"] list{py_name}      ")"
       | lit{"from"i}          "(" [_HM  list{mod_default} ":"] list{py_name}      ")"
       | lit{"grainsize"i}     "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"if"i}            "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"inbranch"i}     ["("       list{mod_default}                         ")"]
       | lit{"initializer"i}   "(" [_HM  list{mod_default} ":"] py_code            ")"
       | lit{"lastprivate"i}   "(" [_HM  list{mod_default} ":"] list{py_name}      ")"
       | lit{"linear"i}        "(" [_HM] linear_mod_mod         "(" list{py_name} ")" \
                                                          [":"  linear_mods]       ")" -> linear_cl_old #<=4.5
       | lit{"linear"i}        "(" [_HM]                        list{py_name} \   
                                                          [":"  linear_mods]       ")"
       | lit{"link"i}          "(" [_HM list{mod_default}  ":"] list{py_name}      ")"
       | lit{"map"i}           "("  _HM map_mods           ":"   list{py_name_sec} ")"
       | lit{"mergeable"i}    ["(" [_HM list{mod_default}  ":"]  py_expr           ")"]
       | lit{"nogroup"i}      ["(" [_HM list{mod_default}  ":"]  py_expr           ")"]
       | lit{"notinbranch"i}  ["("      list{mod_default}                          ")"]
       | lit{"nowait"i}       ["(" [_HM list{mod_default} ":"]  py_expr            ")"]
       | lit{"num_tasks"i}     "(" [_HM list{mod_default} ":"]  py_expr            ")" 
       | lit{"num_teams"i}     "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"num_threads"i}   "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"orderer"i}       "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"priority"i}      "(" [_HM list{mod_default} ":"]  py_expr            ")" 
       | lit{"private"i}       "(" [_HM list{mod_default} ":"]  list{py_name}      ")"
       | lit{"proc_bind"i}     "(" [_HM list{mod_default} ":"]  (lit{"master"i} | lit{"close"i} | lit{"spread"i}) ")"
       | lit{"reduction"i}     "("  _HM reduction_mods    ":"   list{py_name_sec}  ")"
       | lit{"safelen"i}       "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"schedule"i}      "(" [_HM schedule_mods     ":"]  (lit{"static"i} | lit{"dynamic"i} | lit{"guided"i} | lit{"auto"i} | lit{"runtime"i}) ["," py_expr ] ")"
       | lit{"shared"i}        "(" [_HM list{mod_default} ":"]  list{py_name}      ")"
       | lit{"simdlen"i}       "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"thread_limit"i}  "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"to"i}            "(" [_HM list{mod_default} ":"]  list{py_name}      ")"
       | lit{"uniform"i}       "(" [_HM list{mod_default} ":"]  list{py_name}      ")"
       | lit{"untied"i}       ["(" [_HM list{mod_default} ":"]  py_expr            ")"]
       | lit{"use_device_ptr"i}"(" [_HM list{mod_default} ":"]  list{py_name}      ")"
       
atomic_clauses: atomic_clause* -> as_list
atomic_clause: \
         lit{"capture"i}       "(" [_HM  list{mod_default} ":"] py_expr            ")"
       | lit{"read"i}          "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"update"i}        "(" [_HM list{mod_default} ":"]  py_expr            ")" 
       | lit{"write"i}         "(" [_HM list{mod_default} ":"]  py_expr            ")"
       | lit{"seq_cst"i}

##################################################################################
#################################### Modifiers ###################################
##################################################################################
mod_default : directive_mod

dec_rec_mod_old: ":" py_code

directive_mod: NAME

reduction_mods   : [directive_mod ","]  reduction_mod_op -> as_list
reduction_mod_op : reduction_op
?reduction_op    : py_name      | py_lit{"+"i}   | py_lit{"*"i}  | py_lit{"&"i}   | py_lit{"|"i}
                 | py_lit{"^"i} | py_lit{"and"i} | py_lit{"or"i} | py_lit{"max"i} | py_lit{"min"i}

linear_mods   : linear_mod ("," linear_mod)* -> as_list
?linear_mod   : linear_mod_mod | directive_mod
linear_mod_mod: lit{"ref"i} | lit{"uval"i} | lit{"val"i}

schedule_mods        : schedule_mod ("," schedule_mod)* -> as_list
?schedule_mod        : schedule_mod_ordering | schedule_mod_chunk | directive_mod
schedule_mod_ordering: lit{"monotonic"i} | lit{"nonmonotonic"i}
schedule_mod_chunk   : lit{"simd"i}

aligned_mods     : ":" (directive_mod | (directive_mod "," aligned_mod_align)) -> as_list
aligned_mod_align: py_expr

depend_mods    : depend_mod ("," depend_mod)* -> as_list
?depend_mod    : depend_mod_type | directive_mod
depend_mod_type: lit{"in"i} | lit{"out"i}| lit{"inout"i} | lit{"source"i} | lit{"sink"i}

map_mods    : ((map_mod_mod | directive_mod) "," )* map_mod_type -> as_list
map_mod_type: lit{"to"i} | lit{"from"i} | lit{"tofrom"i} | lit{"alloc"i} | lit{"release"i} | lit{"delete"i}
map_mod_mod : lit{"always"i}

defaultmap_mods   : defaultmap_mod ("," defaultmap_mod)* -> as_list
?defaultmap_mod   : defaultmap_mod_cat | directive_mod
defaultmap_mod_cat: lit{"scalar"}

##################################################################################
##################################### Python #####################################
##################################################################################
# https://docs.python.org/3/reference/lexical_analysis.html
# https://docs.python.org/3/reference/grammar.html
# https://github.com/lark-parser/lark/blob/master/lark/grammars/python.lark

py_name: NAME
py_name_sec: py_name py_section*
!py_section: "[" [py_expr_lite] ":" [py_expr_lite] "]"

py_expr_lite: py_code_lite -> py_expr
py_stmt_lite: py_code_lite -> py_stmt
py_code_lite: python_lite  -> py_code

py_expr: py_code
py_stmt: py_code
py_code: python

python: ( NAME | PYTHON_BODY | PYTHON_STRING | PYTHON_LONG_STRING | "(" python ")" )+ -> literal
python_lite: ( NAME | PYTHON_LITE | PYTHON_STRING | PYTHON_LONG_STRING | "(" python ")" | "[" python "]" | "{" python "}")+ -> literal

PYTHON_BODY.-1: /[^()"' \t\f\r\n]+/ # Python code always ends before )
PYTHON_STRING: /([ubft]?r?|r[ubft])("(?!"")(?:\\\n|[^"\\]|\\.)*?"|'(?!'')(?:\\\n|[^'\\]|\\.)*?')/i
PYTHON_LONG_STRING: /([ubft]?r?|r[ubft])(""".*?(?<!\\)(\\\\)*?"""|'''.*?(?<!\\)(\\\\)*?''')/is
PYTHON_LITE.-1 : /[^(){}\[\]:,"']+/

%declare _HM
%import common.CNAME -> NAME
%import common.WS
%ignore WS