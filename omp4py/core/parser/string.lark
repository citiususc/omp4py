##################################################################################
##                                                                              ##
## To generate the string parser from this grammar use the following command:   ##
##                                                                              ##
##   python -m lark.tools.standalone string.lark \                              ##
##     --out string_lark.py --lexer basic                                       ##
##                                                                              ##
##################################################################################

start: (STRING | LONG_STRING)+

STRING: /([ubft]?r?|r[ubft])("(?!"")(?:\\\n|[^"\\]|\\.)*?"|'(?!'')(?:\\\n|[^'\\]|\\.)*?')/i
LONG_STRING: /([ubft]?r?|r[ubft])(""".*?(?<!\\)(\\\\)*?"""|'''.*?(?<!\\)(\\\\)*?''')/is

%import common.WS
%ignore WS
%ignore /#[^\n]*/